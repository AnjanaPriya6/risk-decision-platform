# ── SECRETS AND LOCAL CONFIG ──────────────────────────────────────────────────
# Never commit real values — these files contain passwords, JWT secrets, API keys
application-local.properties
application-local.yml
*.local.properties
*.local.yml
.env
.env.local
.env.*.local

# ── MAVEN BUILD OUTPUT ────────────────────────────────────────────────────────
# Generated by mvn package — not source code, anyone can regenerate it
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── MAVEN WRAPPER ─────────────────────────────────────────────────────────────
.mvn/wrapper/maven-wrapper.properties

# ── INTELLIJ IDEA ─────────────────────────────────────────────────────────────
# IDE configuration — specific to your machine, not useful to others
.idea/
*.iml
*.iws
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# ── ECLIPSE ───────────────────────────────────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ── VS CODE ───────────────────────────────────────────────────────────────────
.vscode/

# ── SPRING BOOT ───────────────────────────────────────────────────────────────
# Spring Boot devtools restart trigger file
.spring-pid

# ── LOGS ──────────────────────────────────────────────────────────────────────
# Log files generated at runtime — not source code
*.log
logs/
log/

# ── OS FILES ──────────────────────────────────────────────────────────────────
# Mac
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ── PYTHON (risk-scoring-service) ─────────────────────────────────────────────
# Python virtual environment
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Python distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Python testing
.pytest_cache/
.coverage
htmlcov/

# ── DOCKER ────────────────────────────────────────────────────────────────────
# Docker override files are usually machine-specific
docker-compose.override.yml

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Local database dumps — never commit these
*.sql.bak
*.dump

# ── POSTMAN ───────────────────────────────────────────────────────────────────
# Postman environment files contain real URLs and tokens
*postman_environment*.json

# ── MISC ──────────────────────────────────────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar